<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% unless page.permalink == '/' %}{{ page.title | escape }} · {% endunless %}
      {{ site.title | escape }}
    </title>
    <meta name="description" content="{{ page.description | default: site.description | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" href="{{ '/assets/images/favicon.svg' | relative_url }}" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/assets/css/clean.css' | relative_url }}">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {% if page.permalink == '/' %}
      <header class="banner" style="--banner-img: url('{{ site.banner_image | relative_url }}');">
        <div class="banner-nav">
          <a class="brand" href="{{ '/' | relative_url }}">{{ site.author.name | escape }}</a>
          {% include navigation.liquid class='links' %}
        </div>
        <div class="banner-hero">
          <h1>{{ site.author.name | escape }}</h1>
          <p class="sub">{{ site.author.affiliation | escape }}</p>
          {% include social-links.liquid icons=true %}
        </div>
      </header>
    {% else %}
      <header class="site-header">
        <div class="header-inner">
          <a class="site-title" href="{{ '/' | relative_url }}">{{ site.author.name | escape }}</a>
          {% include navigation.liquid class='site-nav' %}
        </div>
      </header>
    {% endif %}
    <main id="main-content" class="wrap content content--narrow" tabindex="-1">
      {% unless page.permalink == '/' %}
        <h1 class="page-title">{{ page.title | escape }}</h1>
      {% endunless %}
      {{ content }}
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span>&copy; {{ site.author.name | escape }}, {{ site.time | date: '%Y' }}</span>
        {% include social-links.liquid icons=false %}
      </div>
    </footer>
  </body>
</html>
